<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>SlideFidelity Helper</title>
  <organization>io.slidefidelity</organization>
  <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
  <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
  <volume-check><allowed-os-versions><os-version min="12.0"/></allowed-os-versions></volume-check>
  <welcome file="welcome.html" mime-type="text/html"/>
  <choices-outline><line choice="default"><line choice="com.slidefidelity.helper"/></line></choices-outline>
  <choice id="default"/>
  <choice id="com.slidefidelity.helper" visible="false"><pkg-ref id="com.slidefidelity.helper"/></choice>
  <pkg-ref id="com.slidefidelity.helper" version="__VERSION__" onConclusion="none">helper-component.pkg</pkg-ref>
</installer-gui-script>
